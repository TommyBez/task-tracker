{
  "name": "task-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Native client, project, planning, and reporting workspace.",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "native dev",
    "dev:core": "native dev --core",
    "check": "pnpm check:lines && native check --strict",
    "check:lines": "node scripts/check-file-lines.mjs",
    "test": "native test && pnpm test:behavior && pnpm test:unassigned && pnpm test:csv && pnpm test:budget",
    "test:budget": "NODE_PATH=node_modules/.pnpm/node_modules node node_modules/@native-sdk/cli/build/ts_run.mjs scripts/test-project-budget.ts",
    "test:csv": "NODE_PATH=node_modules/.pnpm/node_modules node node_modules/@native-sdk/cli/build/ts_run.mjs scripts/test-csv-export.ts",
    "test:behavior": "NODE_PATH=node_modules/.pnpm/node_modules node node_modules/@native-sdk/cli/build/ts_run.mjs scripts/test-project-behavior.ts",
    "test:unassigned": "NODE_PATH=node_modules/.pnpm/node_modules node node_modules/@native-sdk/cli/build/ts_run.mjs scripts/test-unassigned-slots.ts",
    "build": "native build"
  },
  "dependencies": {
    "@native-sdk/core": "0.6.2"
  },
  "devDependencies": {
    "@native-sdk/cli": "0.6.2"
  }
}
